# Local dependency and validation caches
.uv-cache/
__pycache__/
*.py[cod]
.pytest_cache/
.venv/

# Node/build output if introduced later
node_modules/
dist/
build/
_site/

# Browser automation profiles must never be tracked or deployed
output/edge-check-profile/
**/edge-check-profile/
**/browser-profile/
**/user-data-dir/

# Temporary files and Office locks
temp/
tmp/
previews/
rendered-pdfs/
verification-output/
~$*.xlsx
~$*.docx
~$*.pptx

# Credentials
.env
.env.*
*.key
*.pem
secrets.json

# OS/editor noise
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.tmp
data/output/.x_report_*.tmp
data/output/.x_report_*.bak
