{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinelgrid.org/schemas/x-sources/1.0",
  "title": "Sentinel Grid X Sources",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "reports"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "reports": {
      "type": "array",
      "items": {"$ref": "#/$defs/report"}
    }
  },
  "$defs": {
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "status_id",
        "account",
        "source_url",
        "published_at",
        "collected_at",
        "summary",
        "event_type",
        "source_class",
        "verification_status",
        "confidence",
        "latitude",
        "longitude",
        "location_name",
        "location_precision"
      ],
      "properties": {
        "schema_version": {"const": "1.0"},
        "status_id": {"type": "string", "pattern": "^[0-9]+$"},
        "account": {"type": "string", "pattern": "^[A-Za-z0-9_]{1,15}$"},
        "source_url": {
          "type": "string",
          "pattern": "^https://x\\.com/[A-Za-z0-9_]{1,15}/status/[0-9]+$"
        },
        "published_at": {"type": "string", "format": "date-time"},
        "collected_at": {"type": "string", "format": "date-time"},
        "summary": {"type": "string", "minLength": 1},
        "event_type": {
          "enum": [
            "reported_attack",
            "reported_military_activity",
            "reported_strike",
            "unclassified_early_report"
          ]
        },
        "source_class": {
          "enum": [
            "social_media_aggregator",
            "social_media_monitor",
            "social_media_osint",
            "unknown_social_media"
          ]
        },
        "verification_status": {
          "enum": [
            "corroborated",
            "disputed",
            "not_independently_verified",
            "unable_to_verify",
            "verified"
          ]
        },
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "latitude": {"type": "number", "minimum": -90, "maximum": 90},
        "longitude": {"type": "number", "minimum": -180, "maximum": 180},
        "location_name": {"type": "string", "minLength": 1},
        "location_precision": {
          "enum": [
            "city",
            "country",
            "exact",
            "facility",
            "facility_approximate",
            "regional_approximate",
            "unknown"
          ]
        },
        "quoted_url": {
          "type": ["string", "null"],
          "pattern": "^https://x\\.com/[A-Za-z0-9_]{1,15}/status/[0-9]+$"
        },
        "reposted_url": {
          "type": ["string", "null"],
          "pattern": "^https://x\\.com/[A-Za-z0-9_]{1,15}/status/[0-9]+$"
        }
      }
    }
  }
}
