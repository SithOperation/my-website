{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sithbusiness.com/schemas/sentinel-news-1.0.json",
  "title": "Sentinel news publication",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "generated_at", "count", "health", "items"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "generated_at": {"type": "string", "format": "date-time"},
    "count": {"type": "integer", "minimum": 0},
    "health": {"type": "object", "required": ["status", "sources"], "properties": {"status": {"enum": ["fresh", "partial", "unavailable"]}, "sources": {"type": "array"}}},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "title", "url", "publisher", "categories", "claim_status"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "summary": {"type": "string"},
          "url": {"type": "string", "pattern": "^https://"},
          "publisher": {"type": "string", "minLength": 1},
          "categories": {"type": "array", "items": {"type": "string"}},
          "detected_keywords": {"type": "array", "items": {"type": "string"}},
          "severity": {"type": "string"},
          "claim_status": {"enum": ["unverified", "single-source report", "corroborated", "officially confirmed", "disputed", "debunked", "retracted", "published_source_report"]},
          "verification_status": {"type": "string"},
          "information_type": {"enum": ["breaking_news", "official_advisory", "confirmed_incident", "unverified_report", "developing_situation", "analysis_opinion", "historical_incident"]},
          "subject_category": {"type": "string"},
          "lifecycle": {"enum": ["developing", "active", "published", "resolved", "historical"]},
          "occurrence_at": {"type": ["string", "null"]},
          "geographic_relevance": {"type": "object"},
          "corroboration": {"type": "object"},
          "verification": {
            "type": "object",
            "required": ["status", "confidence_score", "independent_source_count", "official_confirmation", "evidence", "contradictions", "last_checked"],
            "properties": {
              "status": {"enum": ["unverified", "single-source report", "corroborated", "officially confirmed", "disputed", "debunked", "retracted"]},
              "confidence_score": {"type": ["integer", "null"], "minimum": 0, "maximum": 100},
              "independent_source_count": {"type": "integer", "minimum": 0},
              "official_confirmation": {"type": "boolean"},
              "evidence": {"type": "array"},
              "contradictions": {"type": "array"},
              "last_checked": {"type": ["string", "null"]}
            }
          }
        }
      }
    }
  }
}
